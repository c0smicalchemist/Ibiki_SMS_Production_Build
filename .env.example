# Ibiki SMS Environment Configuration
# Copy this file to .env and fill in your values

# =================================
# CRITICAL: Session & JWT Secrets (REQUIRED)
# =================================
# These secrets are used to sign JWT tokens for login sessions
# IMPORTANT: Never change these after deployment or all users will be logged out!
# Generate random secrets: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_STRING_BEFORE_DEPLOYMENT
JWT_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_STRING_BEFORE_DEPLOYMENT

# =================================
# Super Admin Configuration (RECOMMENDED)
# =================================
# Email address that always has admin privileges
# Leave empty to rely solely on database role assignment
SUPER_ADMIN_EMAIL=ibiki_dash@proton.me

# =================================
# Database Configuration (REQUIRED)
# =================================
# PostgreSQL connection URL - required for data persistence
# For local PostgreSQL (after running setup-postgres.sh):
DATABASE_URL=postgresql://admin:c0smic4382@localhost:5432/ibiki_sms
# For external provider (Neon, Supabase, etc.):
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =================================
# Webhook Security (REQUIRED for Production)
# =================================
# Shared secret for authenticating ExtremeSMS webhook requests
# IMPORTANT: Set this in ExtremeSMS webhook configuration
# Generate a random secret: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_STRING_BEFORE_DEPLOYMENT

# =================================
# Email Service (Optional)
# =================================
# Required only for password reset feature
# Get API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# =================================
# Server Configuration
# =================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# =================================
# Logging
# =================================
LOG_LEVEL=info

# =================================
# SMS Provider (ExtremeSMS)
# =================================
EXTREMESMS_API_KEY=your-extremesms-api-key
EXTREMESMS_SENDER_ID=your-sender-id

# =================================
# SMS Provider (TextBelt - Primary)
# =================================
TEXTBELT_API_KEY=your-textbelt-api-key

# US Proxy for TextBelt (required if server is outside North America)
# TextBelt NA keys only work from NA countries, so we route through a US proxy
# Format: http://username:password@proxy-host:port or http://proxy-host:port
TEXTBELT_PROXY_URL=

# Webshare Proxy API (Optional - for automatic proxy rotation)
# Sign up at https://www.webshare.io and get API key from dashboard
# If configured, proxies will automatically rotate for each request
WEBSHARE_API_KEY=
