# ========================================
# IBIKI SMS - SECURITY FOCUSED .gitignore
# ========================================
# This file lists ALL sensitive files that should NEVER be committed to Git

# ============================================================
# CRITICAL SECURITY - NEVER COMMIT THESE
# ============================================================

# Environment Files (Contains API keys, passwords, database URLs)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env
!.env.example
!.env.sample

# SSH Keys and Certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
*.ppk

# Database Files (May contain sensitive data)
*.sqlite
*.sqlite3
*.db
*.sql
database/
backups/*.sql

# Deployment Credentials
.deployment-credentials
deploy-credentials.json
server-access.txt
passwords.txt
secrets.txt
credentials/

# PM2 Configuration (May contain environment variables)
ecosystem.config.js.local
pm2-production.json

# ============================================================
# BUILD ARTIFACTS (Generated, not source)
# ============================================================

# Build Outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Dependencies
node_modules/
jspm_packages/
bower_components/

# ============================================================
# LOGS AND TEMPORARY FILES
# ============================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ============================================================
# TESTING AND COVERAGE
# ============================================================

# Test coverage
coverage/
*.lcov
.nyc_output/

# Testing
test-results/
playwright-report/

# ============================================================
# IDE AND EDITOR FILES
# ============================================================

# VS Code
.vscode/*
!.vscode/settings.json.example
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#

# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================
# BACKUP FILES (May contain sensitive data)
# ============================================================

# Backup files
*.bak
*.backup
backup-*.tar.gz
backup-*.zip
*.old

# Archive files (if they contain sensitive data)
# archives/
# *.tar.gz
# *.zip

# ============================================================
# CACHE AND LOCK FILES
# ============================================================

# Package manager locks (COMMIT THESE for consistency)
# package-lock.json (KEEP THIS)
# yarn.lock (KEEP THIS)
# pnpm-lock.yaml (KEEP THIS)

# Cache directories
.cache/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/

# ============================================================
# MISCELLANEOUS
# ============================================================

# Debug
*.log
*.stackdump

# Local history
.history/

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# ============================================================
# PROJECT SPECIFIC EXCLUSIONS
# ============================================================

# Local development overrides
local-config.json
dev-settings.json

# Documentation builds (if auto-generated)
docs/api/

# Deployment logs
deployment-*.log
deploy-*.log

# File comparison outputs
*-comparison.txt
missing-files.txt
server-files.txt
local-files.txt

# Temporary sync files
.sync-temp/
